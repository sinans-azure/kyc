# App Service environment settings
PORT=8080
POSTGRES_CONNECTION_STRING=postgresql://<user>:<password>@<host>:5432/<database>
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=<storage-account-name>;AccountKey=<storage-account-key>;EndpointSuffix=core.windows.net
STORAGE_CONTAINER_NAME=insurance-docs
OCR_FUNCTION_URL=https://sinanaf1.azurewebsites.net/api/ocr
FORM_RECOGNIZER_ENDPOINT=https://sinanfr1.cognitiveservices.azure.com/
FORM_RECOGNIZER_API_KEY=<form-recognizer-key>
